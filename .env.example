# Public URL of the deployed site (used for Open Graph image links)
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# MongoDB
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/mockmentor

# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# AI Services
GROQ_API_KEY=gsk_...
# Optional: send Groq requests to another OpenAI-compatible URL (a proxy, or a local mock in tests)
# GROQ_BASE_URL=http://localhost:4010/openai/v1

# Appwrite Storage
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=your_project_id
NEXT_PUBLIC_BUCKET_ID=your_bucket_id
APPWRITE_API_KEY=your_appwrite_api_key
